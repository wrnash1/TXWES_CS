<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/profile/cc/ccv1p1/ccv1p1_qtiasiv1p2p1_v1p0.xsd">
  <assessment ident="g4281f0657a5cc6a01f15611fbd22e87" title="Quiz (M03): Application Attacks and Software Vulnerabilities">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_profile</fieldlabel>
        <fieldentry>cc.exam.v0p1</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_assessmenttype</fieldlabel>
        <fieldentry>Examination</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_scoretype</fieldlabel>
        <fieldentry>Percentage</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>1</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="g4281f0657a5cc6a01f15611fbd22e87_q01" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An organization wants to deploy a new public-facing customer portal. The portal must communicate with a highly secure backend database that stores PII. Which network architectural design provides the most secure placement for these servers?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q01_a">
                <material>
                  <mattext texttype="text/plain">Place both the web server and the database server in the DMZ to ensure fast communication.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q01_b">
                <material>
                  <mattext texttype="text/plain">Place the web server in the DMZ and the database server on the internal secure network.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q01_c">
                <material>
                  <mattext texttype="text/plain">Place both servers on the internal secure network and forward port 80/443 directly from the internet router.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q01_d">
                <material>
                  <mattext texttype="text/plain">Place the database server in the DMZ and the web server on the internal network.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g4281f0657a5cc6a01f15611fbd22e87_q01_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g4281f0657a5cc6a01f15611fbd22e87_q02" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Alice wants to send a highly confidential contract to Bob over an untrusted network. She wants to ensure that &lt;em&gt;only&lt;/em&gt; Bob can read the contract. Using asymmetric cryptography, whose key should Alice use to encrypt the document?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q02_a">
                <material>
                  <mattext texttype="text/plain">Alice's Private Key</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q02_b">
                <material>
                  <mattext texttype="text/plain">Alice's Public Key</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q02_c">
                <material>
                  <mattext texttype="text/plain">Bob's Private Key</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q02_d">
                <material>
                  <mattext texttype="text/plain">Bob's Public Key</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g4281f0657a5cc6a01f15611fbd22e87_q02_d</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g4281f0657a5cc6a01f15611fbd22e87_q03" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A web application accepts a username input field. An attacker enters the string &lt;code&gt;' OR '1'='1&lt;/code&gt; as the username and gains access to the application without knowing any valid credentials. Which type of attack is this?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q03_a">
                <material>
                  <mattext texttype="text/plain">Cross-Site Scripting (XSS)</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q03_b">
                <material>
                  <mattext texttype="text/plain">Buffer Overflow</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q03_c">
                <material>
                  <mattext texttype="text/plain">SQL Injection</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q03_d">
                <material>
                  <mattext texttype="text/plain">Cross-Site Request Forgery (CSRF)</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g4281f0657a5cc6a01f15611fbd22e87_q03_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g4281f0657a5cc6a01f15611fbd22e87_q04" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A developer is building a web application and wants to prevent attackers from injecting malicious database commands through form input fields. Which of the following is the MOST effective defense against SQL injection?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q04_a">
                <material>
                  <mattext texttype="text/plain">Enforce HTTPS with TLS 1.3 on all web server connections.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q04_b">
                <material>
                  <mattext texttype="text/plain">Use parameterized queries (prepared statements) for all database interactions.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q04_c">
                <material>
                  <mattext texttype="text/plain">Implement a Web Application Firewall (WAF) as the sole defense layer.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q04_d">
                <material>
                  <mattext texttype="text/plain">Hash all user input with SHA-256 before passing it to the database.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g4281f0657a5cc6a01f15611fbd22e87_q04_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g4281f0657a5cc6a01f15611fbd22e87_q05" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A security engineer is hardening a web application against cross-site scripting (XSS) attacks. Which combination of controls provides the strongest defense?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q05_a">
                <material>
                  <mattext texttype="text/plain">Enable full disk encryption and enforce strong password policies for all database accounts.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q05_b">
                <material>
                  <mattext texttype="text/plain">Implement output encoding for all user-supplied content and deploy a Content Security Policy (CSP) header.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q05_c">
                <material>
                  <mattext texttype="text/plain">Require multi-factor authentication for all user logins and enforce session timeouts.</mattext>
                </material>
              </response_label>
              <response_label ident="g4281f0657a5cc6a01f15611fbd22e87_q05_d">
                <material>
                  <mattext texttype="text/plain">Deploy an IDS to monitor network traffic for XSS signatures and alert the SOC team.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g4281f0657a5cc6a01f15611fbd22e87_q05_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
    </section>
  </assessment>
</questestinterop>
