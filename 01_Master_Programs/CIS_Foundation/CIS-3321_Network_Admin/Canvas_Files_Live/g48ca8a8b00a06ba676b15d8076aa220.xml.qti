<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/profile/cc/ccv1p1/ccv1p1_qtiasiv1p2p1_v1p0.xsd">
  <assessment ident="g48ca8a8b00a06ba676b15d8076aa220" title="Quiz (M15): Network Documentation and Policies">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_profile</fieldlabel>
        <fieldentry>cc.exam.v0p1</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_assessmenttype</fieldlabel>
        <fieldentry>Examination</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_scoretype</fieldlabel>
        <fieldentry>Percentage</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>1</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q01" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A network diagram shows IP addressing schemes, VLAN assignments, routing protocols, and traffic flows, but does not show cable routes or physical port connections. Which type of diagram is this?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q01_a">
                <material>
                  <mattext texttype="text/plain">Physical network diagram</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q01_b">
                <material>
                  <mattext texttype="text/plain">Rack diagram</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q01_c">
                <material>
                  <mattext texttype="text/plain">Logical network diagram</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q01_d">
                <material>
                  <mattext texttype="text/plain">Topology map</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q01_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q02" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A 99.99% availability SLA allows how much maximum annual downtime?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q02_a">
                <material>
                  <mattext texttype="text/plain">8.76 hours</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q02_b">
                <material>
                  <mattext texttype="text/plain">87.6 hours</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q02_c">
                <material>
                  <mattext texttype="text/plain">52.6 minutes</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q02_d">
                <material>
                  <mattext texttype="text/plain">5.26 minutes</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q02_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q03" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An organization's business continuity plan states that the ERP system must be restored within 2 hours of any failure, and no more than 30 minutes of transaction data may be lost. Which terms correctly describe these two requirements?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q03_a">
                <material>
                  <mattext texttype="text/plain">RTO = 30 minutes, RPO = 2 hours</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q03_b">
                <material>
                  <mattext texttype="text/plain">MTTR = 2 hours, MTBF = 30 minutes</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q03_c">
                <material>
                  <mattext texttype="text/plain">RTO = 2 hours, RPO = 30 minutes</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q03_d">
                <material>
                  <mattext texttype="text/plain">RPO = 2 hours, SLA = 30 minutes</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q03_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q04" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An administrator discovers that a router's running configuration has been modified from the organization's approved baseline without any corresponding change request. What has occurred?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q04_a">
                <material>
                  <mattext texttype="text/plain">An emergency change that was properly expedited</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q04_b">
                <material>
                  <mattext texttype="text/plain">Configuration drift — an unauthorized deviation from the baseline</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q04_c">
                <material>
                  <mattext texttype="text/plain">A standard change that did not require CAB approval</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q04_d">
                <material>
                  <mattext texttype="text/plain">A normal change that was approved verbally</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q04_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q05" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A network engineer needs to push a critical security patch to a core router at 11 PM to address an actively exploited vulnerability. No scheduled maintenance window exists. Which change type is most appropriate?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q05_a">
                <material>
                  <mattext texttype="text/plain">Standard change — follows a pre-approved procedure</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q05_b">
                <material>
                  <mattext texttype="text/plain">Normal change — requires full CAB review and scheduling</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q05_c">
                <material>
                  <mattext texttype="text/plain">Emergency change — urgent, expedited approval required</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q05_d">
                <material>
                  <mattext texttype="text/plain">Unauthorized change — no process exists for unscheduled changes</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q05_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q06" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A new employee connects to the company Wi-Fi and is redirected to a page requiring them to read and click "I Accept" before accessing the network. This is the primary mechanism for which document?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q06_a">
                <material>
                  <mattext texttype="text/plain">Service Level Agreement</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q06_b">
                <material>
                  <mattext texttype="text/plain">Acceptable Use Policy acknowledgment</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q06_c">
                <material>
                  <mattext texttype="text/plain">Change Request approval</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q06_d">
                <material>
                  <mattext texttype="text/plain">Network diagram access authorization</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q06_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q07" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An organization's primary data center is destroyed by flooding. At its disaster recovery site, all network hardware is pre-installed, powered on, and running. Data is replicated to this site in real time. Failover can be completed within 15 minutes. Which DR site type is this?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q07_a">
                <material>
                  <mattext texttype="text/plain">Cold site</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q07_b">
                <material>
                  <mattext texttype="text/plain">Warm site</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q07_c">
                <material>
                  <mattext texttype="text/plain">Hot site</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q07_d">
                <material>
                  <mattext texttype="text/plain">Mirrored site</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q07_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q08" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the primary purpose of including a rollback plan in a Change Request?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q08_a">
                <material>
                  <mattext texttype="text/plain">To satisfy regulatory documentation requirements</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q08_b">
                <material>
                  <mattext texttype="text/plain">To provide step-by-step instructions to restore the previous configuration if the change causes problems</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q08_c">
                <material>
                  <mattext texttype="text/plain">To document what the change accomplished after it is complete</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q08_d">
                <material>
                  <mattext texttype="text/plain">To identify which team member implemented the change</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q08_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q09" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An organization runs full interruption disaster recovery testing annually. During the test, production systems are actually failed over to the DR site. What is the main benefit of this test type compared to a tabletop exercise?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q09_a">
                <material>
                  <mattext texttype="text/plain">It requires less time and causes no disruption</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q09_b">
                <material>
                  <mattext texttype="text/plain">It provides the highest confidence that DR procedures actually work in a real failure scenario</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q09_c">
                <material>
                  <mattext texttype="text/plain">It satisfies all regulatory testing requirements without any risk</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q09_d">
                <material>
                  <mattext texttype="text/plain">It eliminates the need for a DR plan update afterward</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q09_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="g48ca8a8b00a06ba676b15d8076aa220_q10" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which IPAM tool integrates DNS, DHCP, and IP address management into a unified platform, allowing automatic DNS record creation when addresses are assigned?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q10_a">
                <material>
                  <mattext texttype="text/plain">Wireshark</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q10_b">
                <material>
                  <mattext texttype="text/plain">Packet Tracer</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q10_c">
                <material>
                  <mattext texttype="text/plain">DDI platform (e.g., Infoblox, BlueCat)</mattext>
                </material>
              </response_label>
              <response_label ident="g48ca8a8b00a06ba676b15d8076aa220_q10_d">
                <material>
                  <mattext texttype="text/plain">Nmap</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">g48ca8a8b00a06ba676b15d8076aa220_q10_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
    </section>
  </assessment>
</questestinterop>
