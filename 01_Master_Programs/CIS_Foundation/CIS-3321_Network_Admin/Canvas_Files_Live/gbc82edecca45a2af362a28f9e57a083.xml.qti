    <section ident="root_section">
      <item ident="gbc82edecca45a2af362a28f9e57a083_q01" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which VoIP codec provides toll-quality (PSTN-equivalent) audio and uses approximately 87 Kbps of bandwidth per call including IP/UDP/RTP header overhead?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q01_a">
                <material>
                  <mattext texttype="text/plain">G.729</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q01_b">
                <material>
                  <mattext texttype="text/plain">G.722</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q01_c">
                <material>
                  <mattext texttype="text/plain">G.711</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q01_d">
                <material>
                  <mattext texttype="text/plain">Opus</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q01_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q02" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the maximum recommended one-way latency for acceptable VoIP call quality according to ITU-T G.114?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q02_a">
                <material>
                  <mattext texttype="text/plain">50 ms</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q02_b">
                <material>
                  <mattext texttype="text/plain">150 ms</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q02_c">
                <material>
                  <mattext texttype="text/plain">300 ms</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q02_d">
                <material>
                  <mattext texttype="text/plain">600 ms</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q02_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q03" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;In a SIP call, which method is used to terminate an already-established call session?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q03_a">
                <material>
                  <mattext texttype="text/plain">CANCEL</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q03_b">
                <material>
                  <mattext texttype="text/plain">REGISTER</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q03_c">
                <material>
                  <mattext texttype="text/plain">BYE</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q03_d">
                <material>
                  <mattext texttype="text/plain">OPTIONS</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q03_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q04" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which protocol carries the actual voice audio between two VoIP endpoints after the SIP signaling completes?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q04_a">
                <material>
                  <mattext texttype="text/plain">SIP</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q04_b">
                <material>
                  <mattext texttype="text/plain">H.225</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q04_c">
                <material>
                  <mattext texttype="text/plain">RTP</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q04_d">
                <material>
                  <mattext texttype="text/plain">RTCP</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q04_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q05" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the DSCP value used to mark voice RTP packets for the highest QoS priority treatment?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q05_a">
                <material>
                  <mattext texttype="text/plain">DSCP 0 (Best Effort)</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q05_b">
                <material>
                  <mattext texttype="text/plain">DSCP 24 (CS3)</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q05_c">
                <material>
                  <mattext texttype="text/plain">DSCP 34 (AF41)</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q05_d">
                <material>
                  <mattext texttype="text/plain">DSCP 46 (EF)</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q05_d</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q06" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A network engineer notices that VoIP users are reporting choppy audio even though packet loss is near zero and average latency is acceptable. Which issue is most likely causing the choppy audio?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q06_a">
                <material>
                  <mattext texttype="text/plain">Insufficient codec bandwidth</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q06_b">
                <material>
                  <mattext texttype="text/plain">High jitter causing packets to arrive at inconsistent intervals</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q06_c">
                <material>
                  <mattext texttype="text/plain">The SIP proxy is dropping INVITE messages</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q06_d">
                <material>
                  <mattext texttype="text/plain">RTCP is consuming too much bandwidth</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q06_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q07" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which H.323 component provides address translation and call admission control, routing calls between H.323 terminals on behalf of the network administrator?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q07_a">
                <material>
                  <mattext texttype="text/plain">MCU (Multipoint Control Unit)</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q07_b">
                <material>
                  <mattext texttype="text/plain">Gateway</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q07_c">
                <material>
                  <mattext texttype="text/plain">Gatekeeper</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q07_d">
                <material>
                  <mattext texttype="text/plain">Terminal</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q07_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q08" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A company deploys IP phones on access switch ports. The phones are on VLAN 20 (voice) and each phone has a PC connected through the phone's built-in switch port on VLAN 10 (data). The phones tag their own traffic with VLAN 20. Which switch port configuration mode enables this design?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q08_a">
                <material>
                  <mattext texttype="text/plain">Trunk port — allows all VLANs</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q08_b">
                <material>
                  <mattext texttype="text/plain">Access port with voice VLAN configured</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q08_c">
                <material>
                  <mattext texttype="text/plain">Routed port with subinterfaces</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q08_d">
                <material>
                  <mattext texttype="text/plain">Private VLAN port with isolated secondary VLAN</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q08_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q09" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Why is NAT problematic for SIP VoIP calls?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q09_a">
                <material>
                  <mattext texttype="text/plain">SIP uses TCP which NAT cannot translate</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q09_b">
                <material>
                  <mattext texttype="text/plain">SIP embeds IP addresses in the application-layer SDP payload that NAT does not rewrite</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q09_c">
                <material>
                  <mattext texttype="text/plain">NAT blocks UDP port 5060 by default</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q09_d">
                <material>
                  <mattext texttype="text/plain">SIP requires a dedicated public IP per call</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q09_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbc82edecca45a2af362a28f9e57a083_q10" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which queuing mechanism is recommended for networks carrying VoIP traffic, providing strict priority forwarding for voice while giving guaranteed minimum bandwidth to other traffic classes?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q10_a">
                <material>
                  <mattext texttype="text/plain">FIFO (First In, First Out)</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q10_b">
                <material>
                  <mattext texttype="text/plain">Priority Queuing (PQ) with four fixed queues</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q10_c">
                <material>
                  <mattext texttype="text/plain">Low Latency Queuing (LLQ)</mattext>
                </material>
              </response_label>
              <response_label ident="gbc82edecca45a2af362a28f9e57a083_q10_d">
                <material>
                  <mattext texttype="text/plain">Weighted Fair Queuing (WFQ)</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gbc82edecca45a2af362a28f9e57a083_q10_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
    </section>
  </assessment>
</questestinterop>
