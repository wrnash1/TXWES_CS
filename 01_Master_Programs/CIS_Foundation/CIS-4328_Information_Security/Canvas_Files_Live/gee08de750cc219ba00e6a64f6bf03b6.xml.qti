<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/profile/cc/ccv1p1/ccv1p1_qtiasiv1p2p1_v1p0.xsd">
  <assessment ident="gee08de750cc219ba00e6a64f6bf03b6" title="Quiz (M12): Digital Forensics">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_profile</fieldlabel>
        <fieldentry>cc.exam.v0p1</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_assessmenttype</fieldlabel>
        <fieldentry>Examination</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_scoretype</fieldlabel>
        <fieldentry>Percentage</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>1</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q01" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A digital forensics investigator arrives at a scene where a suspect's laptop is powered on and displaying an active desktop. According to the order of volatility, what should the investigator collect FIRST?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q01_a">
                <material>
                  <mattext texttype="text/plain">A forensic image of the hard drive</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q01_b">
                <material>
                  <mattext texttype="text/plain">The contents of system RAM</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q01_c">
                <material>
                  <mattext texttype="text/plain">Log files stored on the hard drive</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q01_d">
                <material>
                  <mattext texttype="text/plain">Files in the user's Documents folder</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q01_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q02" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A forensic investigator connects a suspect hard drive to their forensic workstation. Before imaging, they insert a hardware device between the drive and the workstation that allows all read operations but blocks all write operations. What is this device called?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q02_a">
                <material>
                  <mattext texttype="text/plain">Forensic bridge</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q02_b">
                <material>
                  <mattext texttype="text/plain">Write blocker</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q02_c">
                <material>
                  <mattext texttype="text/plain">Hash validator</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q02_d">
                <material>
                  <mattext texttype="text/plain">Chain-of-custody seal</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q02_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q03" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;After creating a forensic image, an investigator calculates the SHA-256 hash of both the original drive and the forensic image. The hashes match. What has the investigator confirmed?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q03_a">
                <material>
                  <mattext texttype="text/plain">The drive contains no malware</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q03_b">
                <material>
                  <mattext texttype="text/plain">The forensic image is an exact, unmodified copy of the original drive</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q03_c">
                <material>
                  <mattext texttype="text/plain">The chain of custody is complete</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q03_d">
                <material>
                  <mattext texttype="text/plain">The suspect modified the drive after acquisition</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q03_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q04" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An investigator uses the &lt;code&gt;dd&lt;/code&gt; command to image a suspect drive. Later, another investigator needs to analyze the image using a commercial forensic suite. The commercial suite refuses to open the &lt;code&gt;.img&lt;/code&gt; file. What is the likely cause and what image format would have been more compatible?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q04_a">
                <material>
                  <mattext texttype="text/plain">dd produces E01 format which is not universally supported; use raw format instead</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q04_b">
                <material>
                  <mattext texttype="text/plain">dd produces a raw format which some tools do not natively support; FTK Imager's E01 format includes metadata and is more widely supported</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q04_c">
                <material>
                  <mattext texttype="text/plain">dd cannot image NTFS drives; FTK Imager should have been used</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q04_d">
                <material>
                  <mattext texttype="text/plain">dd produces SHA-256 encrypted images that require a decryption key</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q04_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q05" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A security analyst uses the Volatility framework's &lt;code&gt;malfind&lt;/code&gt; plugin on a memory image. The plugin identifies a memory region in &lt;code&gt;explorer.exe&lt;/code&gt; that is marked executable, is not backed by a file on disk, and contains an MZ header. What attack technique does this most likely indicate?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q05_a">
                <material>
                  <mattext texttype="text/plain">SQL injection</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q05_b">
                <material>
                  <mattext texttype="text/plain">Code injection (process hollowing or DLL injection)</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q05_c">
                <material>
                  <mattext texttype="text/plain">Brute force password attack</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q05_d">
                <material>
                  <mattext texttype="text/plain">ARP poisoning</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q05_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q06" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A forensic investigator discovers that a malware sample executed entirely in memory using PowerShell without writing any files to disk. The attacker then deleted all PowerShell logs. Which forensic technique is MOST likely to reveal the malicious PowerShell commands that were executed?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q06_a">
                <material>
                  <mattext texttype="text/plain">File carving on unallocated disk space</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q06_b">
                <material>
                  <mattext texttype="text/plain">Analysis of Prefetch files</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q06_c">
                <material>
                  <mattext texttype="text/plain">Memory forensics on a RAM capture taken during or after the attack</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q06_d">
                <material>
                  <mattext texttype="text/plain">Review of the Windows Security Event Log</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q06_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q07" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A Windows forensic analyst examines a compromised system and finds a file in &lt;code&gt;C:\Windows\Prefetch\&lt;/code&gt; named &lt;code&gt;MIMIKATZ.EXE-3A1F9C2B.pf&lt;/code&gt;. The executable itself is not present on the system. What does this Prefetch file prove?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q07_a">
                <material>
                  <mattext texttype="text/plain">Mimikatz was never actually run on this system</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q07_b">
                <material>
                  <mattext texttype="text/plain">Mimikatz was executed on this system at some point before the Prefetch file was created</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q07_c">
                <material>
                  <mattext texttype="text/plain">The Prefetch file itself is the malware</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q07_d">
                <material>
                  <mattext texttype="text/plain">Mimikatz is a legitimate Windows system tool</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q07_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q08" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An investigator reviews Windows Security Event Logs and finds multiple Event ID 4625 entries with the same source IP address and different account names over a five-minute period. What type of attack does this pattern indicate?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q08_a">
                <material>
                  <mattext texttype="text/plain">Pass-the-hash</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q08_b">
                <material>
                  <mattext texttype="text/plain">Session hijacking</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q08_c">
                <material>
                  <mattext texttype="text/plain">Brute force or credential stuffing</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q08_d">
                <material>
                  <mattext texttype="text/plain">Privilege escalation</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q08_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q09" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A forensic analyst finds the following Windows Event Log entry:&lt;/p&gt;
&lt;pre&gt;&lt;code&gt;EventID: 7045
Service Name: WinUpdate32
Service File: C:\Users\Public\svchost.exe
&lt;/code&gt;&lt;/pre&gt;
&lt;p&gt;What does this entry most likely represent?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q09_a">
                <material>
                  <mattext texttype="text/plain">A legitimate Windows update service</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q09_b">
                <material>
                  <mattext texttype="text/plain">An attacker-installed persistence mechanism via a malicious service</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q09_c">
                <material>
                  <mattext texttype="text/plain">A failed service installation</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q09_d">
                <material>
                  <mattext texttype="text/plain">A security patch being applied</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q09_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q10" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An attacker modifies the &lt;code&gt;$STANDARD_INFORMATION&lt;/code&gt; attribute timestamps on a malware file to make it appear the file was created three years ago. However, the &lt;code&gt;$FILE_NAME&lt;/code&gt; attribute timestamps still show the actual creation time. What anti-forensics technique is this and what forensic artifact reveals it?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q10_a">
                <material>
                  <mattext texttype="text/plain">Log wiping; revealed by event log analysis</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q10_b">
                <material>
                  <mattext texttype="text/plain">Timestomping; revealed by the discrepancy between $STANDARD_INFORMATION and $FILE_NAME timestamps in the MFT</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q10_c">
                <material>
                  <mattext texttype="text/plain">Steganography; revealed by file carving</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q10_d">
                <material>
                  <mattext texttype="text/plain">Living off the land; revealed by Prefetch files</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q10_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q11" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A forensic investigator recovers images from a hard drive that were deleted six months ago. The investigator found the images in unallocated space by scanning for JPEG file headers (&lt;code&gt;FF D8 FF&lt;/code&gt;) and footers (&lt;code&gt;FF D9&lt;/code&gt;). What forensic technique was used?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q11_a">
                <material>
                  <mattext texttype="text/plain">Slack space analysis</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q11_b">
                <material>
                  <mattext texttype="text/plain">Log carving</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q11_c">
                <material>
                  <mattext texttype="text/plain">File carving</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q11_d">
                <material>
                  <mattext texttype="text/plain">Hash matching</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q11_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q12" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;During a forensic investigation, an analyst discovers evidence that the subject was committing tax fraud unrelated to the original investigation (which was about data theft). The analyst is a corporate investigator, not law enforcement. What is the MOST appropriate immediate action?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q12_a">
                <material>
                  <mattext texttype="text/plain">Continue analyzing only the data theft evidence and ignore the tax fraud</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q12_b">
                <material>
                  <mattext texttype="text/plain">Immediately send all evidence to the IRS</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q12_c">
                <material>
                  <mattext texttype="text/plain">Preserve all discovered evidence, stop reviewing out-of-scope material, and consult with legal counsel</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q12_d">
                <material>
                  <mattext texttype="text/plain">Delete the tax fraud evidence to protect the company from liability</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q12_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q13" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A forensic examiner analyzes a cloud-hosted application investigation. The organization used AWS and needs to review who accessed the S3 bucket containing sensitive data. Which AWS service provides the required audit log?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q13_a">
                <material>
                  <mattext texttype="text/plain">Amazon CloudWatch Metrics</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q13_b">
                <material>
                  <mattext texttype="text/plain">AWS Config</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q13_c">
                <material>
                  <mattext texttype="text/plain">AWS CloudTrail</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q13_d">
                <material>
                  <mattext texttype="text/plain">Amazon GuardDuty</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q13_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q14" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An analyst reviews the following web server log entry:&lt;/p&gt;
&lt;pre&gt;&lt;code&gt;GET /search?q=1+UNION+SELECT+username,password+FROM+users-- HTTP/1.1
&lt;/code&gt;&lt;/pre&gt;
&lt;p&gt;What attack does this log entry represent?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q14_a">
                <material>
                  <mattext texttype="text/plain">Cross-site scripting (XSS)</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q14_b">
                <material>
                  <mattext texttype="text/plain">SQL injection using UNION-based extraction</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q14_c">
                <material>
                  <mattext texttype="text/plain">Directory traversal</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q14_d">
                <material>
                  <mattext texttype="text/plain">Command injection</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q14_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q15" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A forensic investigator receives a hard drive and immediately begins analysis on the original drive without creating a forensic image. During analysis, the investigator's tool updates file access timestamps on several files. Why is this a critical error?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q15_a">
                <material>
                  <mattext texttype="text/plain">The analysis will be slower without an image</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q15_b">
                <material>
                  <mattext texttype="text/plain">Modifying the original evidence violates forensic integrity principles and may make evidence inadmissible; the investigator can no longer prove the evidence is in its original state</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q15_c">
                <material>
                  <mattext texttype="text/plain">The hard drive may overheat without an imaging step</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q15_d">
                <material>
                  <mattext texttype="text/plain">Updated timestamps are not legally significant</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q15_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q16" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which Volatility 3 plugin is MOST useful for identifying memory regions in a running process that contain executable code not backed by a file on disk — a primary indicator of fileless malware?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q16_a">
                <material>
                  <mattext texttype="text/plain">windows.pslist</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q16_b">
                <material>
                  <mattext texttype="text/plain">windows.netscan</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q16_c">
                <material>
                  <mattext texttype="text/plain">windows.malfind</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q16_d">
                <material>
                  <mattext texttype="text/plain">windows.cmdline</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q16_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q17" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An investigator performs live acquisition on a running Windows server to preserve volatile evidence. The investigation is expected to lead to criminal prosecution. What additional step is MOST important during live acquisition to protect the forensic integrity of the collected data?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q17_a">
                <material>
                  <mattext texttype="text/plain">Shut down the server before any acquisition</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q17_b">
                <material>
                  <mattext texttype="text/plain">Document every command run and every action taken, with timestamps, in the chain of custody record</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q17_c">
                <material>
                  <mattext texttype="text/plain">Image the disk before capturing RAM</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q17_d">
                <material>
                  <mattext texttype="text/plain">Notify the suspect before beginning acquisition</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q17_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q18" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An attacker used Windows Event Log clearing to hide their activities. An investigator finds the Security log is empty but notices the following entry at the beginning of the log:&lt;/p&gt;
&lt;pre&gt;&lt;code&gt;EventID: 1102 — The audit log was cleared. Subject: Administrator
&lt;/code&gt;&lt;/pre&gt;
&lt;p&gt;What does this entry indicate?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q18_a">
                <material>
                  <mattext texttype="text/plain">The event log cleared itself automatically due to size limits</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q18_b">
                <material>
                  <mattext texttype="text/plain">An administrator cleared the Security event log, which is itself a suspicious action that was logged even after clearing</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q18_c">
                <material>
                  <mattext texttype="text/plain">All security events were successfully deleted without a trace</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q18_d">
                <material>
                  <mattext texttype="text/plain">The system needs to be patched to prevent log clearing</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q18_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q19" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_response.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A forensic investigator is documenting chain of custody for a seized USB drive. Which TWO items are MOST critical to include in the chain of custody record for this physical evidence? (Select TWO)&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q19_a">
                <material>
                  <mattext texttype="text/plain">The drive's purchase price</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q19_b">
                <material>
                  <mattext texttype="text/plain">The MD5 hash of the drive's contents</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q19_c">
                <material>
                  <mattext texttype="text/plain">The name and signature of every person who has handled the drive</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q19_d">
                <material>
                  <mattext texttype="text/plain">The make, model, and serial number of the drive</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q19_e">
                <material>
                  <mattext texttype="text/plain">The color and brand of the tamper-evident packaging used</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <and>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q19_c</varequal>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q19_d</varequal>
              <not><varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q19_a</varequal></not>
              <not><varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q19_b</varequal></not>
              <not><varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q19_e</varequal></not>
            </and>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gee08de750cc219ba00e6a64f6bf03b6_q20" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;During a memory forensics investigation, Volatility's &lt;code&gt;windows.netscan&lt;/code&gt; output shows a network connection from &lt;code&gt;svchost.exe&lt;/code&gt; to IP address &lt;code&gt;185.220.101.45&lt;/code&gt; on port 4444. Port 4444 is commonly used by Metasploit's Meterpreter reverse shell. What does this finding indicate?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q20_a">
                <material>
                  <mattext texttype="text/plain">svchost.exe is functioning normally</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q20_b">
                <material>
                  <mattext texttype="text/plain">svchost.exe has likely been compromised and is maintaining a command-and-control connection</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q20_c">
                <material>
                  <mattext texttype="text/plain">The system is conducting a port scan</mattext>
                </material>
              </response_label>
              <response_label ident="gee08de750cc219ba00e6a64f6bf03b6_q20_d">
                <material>
                  <mattext texttype="text/plain">Port 4444 is a standard Windows update port</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gee08de750cc219ba00e6a64f6bf03b6_q20_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
    </section>
  </assessment>
</questestinterop>
