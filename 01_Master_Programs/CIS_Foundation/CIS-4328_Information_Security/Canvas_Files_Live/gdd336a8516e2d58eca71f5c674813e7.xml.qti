<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/profile/cc/ccv1p1/ccv1p1_qtiasiv1p2p1_v1p0.xsd">
  <assessment ident="gdd336a8516e2d58eca71f5c674813e7" title="Quiz (M05): Cryptography and PKI">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_profile</fieldlabel>
        <fieldentry>cc.exam.v0p1</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_assessmenttype</fieldlabel>
        <fieldentry>Examination</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_scoretype</fieldlabel>
        <fieldentry>Percentage</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>cc_maxattempts</fieldlabel>
        <fieldentry>1</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="root_section">
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q01" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A company needs to encrypt a 500 GB database backup stored on tape. Which algorithm is MOST appropriate for this use case?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q01_a">
                <material>
                  <mattext texttype="text/plain">RSA-2048</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q01_b">
                <material>
                  <mattext texttype="text/plain">ECC-256</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q01_c">
                <material>
                  <mattext texttype="text/plain">AES-256</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q01_d">
                <material>
                  <mattext texttype="text/plain">SHA-256</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q01_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q02" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An analyst reviewing TLS configurations discovers that a web server is configured to use RSA key exchange rather than ECDHE for establishing session keys. Which security property is ABSENT from sessions established with RSA key exchange?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q02_a">
                <material>
                  <mattext texttype="text/plain">Confidentiality</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q02_b">
                <material>
                  <mattext texttype="text/plain">Integrity</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q02_c">
                <material>
                  <mattext texttype="text/plain">Perfect Forward Secrecy</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q02_d">
                <material>
                  <mattext texttype="text/plain">Authentication</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q02_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q03" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A user receives a digitally signed email from a colleague. The signature verification succeeds. What two security properties does this confirmation provide?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q03_a">
                <material>
                  <mattext texttype="text/plain">Confidentiality and availability</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q03_b">
                <material>
                  <mattext texttype="text/plain">Authentication and non-repudiation</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q03_c">
                <material>
                  <mattext texttype="text/plain">Integrity and confidentiality</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q03_d">
                <material>
                  <mattext texttype="text/plain">Non-repudiation and availability</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q03_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q04" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which of the following accurately describes the relationship between a Root CA and an Intermediate CA in a PKI hierarchy?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q04_a">
                <material>
                  <mattext texttype="text/plain">The Root CA issues end-entity certificates; the Intermediate CA handles revocation.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q04_b">
                <material>
                  <mattext texttype="text/plain">The Root CA signs the Intermediate CA's certificate; the Intermediate CA issues end-entity certificates.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q04_c">
                <material>
                  <mattext texttype="text/plain">The Intermediate CA signs the Root CA's certificate to establish mutual trust.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q04_d">
                <material>
                  <mattext texttype="text/plain">Both CAs can issue end-entity certificates independently of each other.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q04_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q05" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A security analyst discovers that a server's TLS certificate uses a SHA-1 signature. What is the PRIMARY security concern?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q05_a">
                <material>
                  <mattext texttype="text/plain">SHA-1 produces a digest that is too short to provide confidentiality.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q05_b">
                <material>
                  <mattext texttype="text/plain">SHA-1 collisions have been demonstrated, meaning an attacker could forge a certificate with the same hash.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q05_c">
                <material>
                  <mattext texttype="text/plain">SHA-1 is a symmetric algorithm and should not be used in certificates.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q05_d">
                <material>
                  <mattext texttype="text/plain">SHA-1 key sizes are too small for modern encryption requirements.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q05_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q06" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An administrator wants to check in real time whether a specific TLS certificate has been revoked before accepting it. Which mechanism provides this capability?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q06_a">
                <material>
                  <mattext texttype="text/plain">CRL</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q06_b">
                <material>
                  <mattext texttype="text/plain">OCSP</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q06_c">
                <material>
                  <mattext texttype="text/plain">OCSP Stapling</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q06_d">
                <material>
                  <mattext texttype="text/plain">Certificate Transparency</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q06_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q07" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which statement BEST describes the mathematical basis that makes ECC more efficient than RSA for the same security level?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q07_a">
                <material>
                  <mattext texttype="text/plain">ECC uses symmetric key operations internally, which are faster than asymmetric operations.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q07_b">
                <material>
                  <mattext texttype="text/plain">ECC is based on the elliptic curve discrete logarithm problem, which is harder to solve per bit than the integer factorization problem underlying RSA.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q07_c">
                <material>
                  <mattext texttype="text/plain">ECC uses longer keys than RSA, which allows it to operate on smaller data blocks.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q07_d">
                <material>
                  <mattext texttype="text/plain">ECC eliminates the need for key exchange entirely.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q07_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q08" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;A developer is implementing a password storage system. They plan to hash each password with SHA-256 before storing it. A security reviewer flags this as insufficient. What additional mechanism MUST be applied to prevent rainbow table attacks?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q08_a">
                <material>
                  <mattext texttype="text/plain">Encrypt the SHA-256 hash with AES before storing.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q08_b">
                <material>
                  <mattext texttype="text/plain">Add a unique random value (salt) to each password before hashing.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q08_c">
                <material>
                  <mattext texttype="text/plain">Use SHA-512 instead of SHA-256 for a larger hash output.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q08_d">
                <material>
                  <mattext texttype="text/plain">Hash each password twice to produce a double hash.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q08_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q09" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;During the TLS handshake, the server sends its digital certificate to the client. What is the PRIMARY purpose of this certificate in the handshake?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q09_a">
                <material>
                  <mattext texttype="text/plain">To encrypt the session data using the server's public key.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q09_b">
                <material>
                  <mattext texttype="text/plain">To allow the client to verify the server's identity and obtain the server's public key.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q09_c">
                <material>
                  <mattext texttype="text/plain">To provide the symmetric session key to the client.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q09_d">
                <material>
                  <mattext texttype="text/plain">To sign the client's certificate request.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q09_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gdd336a8516e2d58eca71f5c674813e7_q10" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;An organization's internal PKI has three levels: a root CA, two intermediate CAs, and thousands of end-entity certificates. The root CA's private key is compromised. What is the MOST accurate statement about the impact?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q10_a">
                <material>
                  <mattext texttype="text/plain">Only the certificates issued by the compromised root CA are affected; intermediate CA certificates remain valid.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q10_b">
                <material>
                  <mattext texttype="text/plain">The entire PKI is compromised, because all trust in the hierarchy ultimately derives from the root CA.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q10_c">
                <material>
                  <mattext texttype="text/plain">Only the intermediate CAs need to reissue their certificates; end-entity certificates are unaffected.</mattext>
                </material>
              </response_label>
              <response_label ident="gdd336a8516e2d58eca71f5c674813e7_q10_d">
                <material>
                  <mattext texttype="text/plain">The impact is limited to TLS certificates; code signing and email certificates are unaffected.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">gdd336a8516e2d58eca71f5c674813e7_q10_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
    </section>
  </assessment>
</questestinterop>
