    <section ident="root_section">
      <item ident="ga2e95d699d77bbba38e84dd3e6d4675_q01" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;On which day and time does this Hybrid course meet in person each week?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q01_a">
                <material>
                  <mattext texttype="text/plain">Tuesday, 6:00 PM – 7:15 PM</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q01_b">
                <material>
                  <mattext texttype="text/plain">Thursday, 6:00 PM – 7:15 PM</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q01_c">
                <material>
                  <mattext texttype="text/plain">Wednesday, 6:00 PM – 7:15 PM</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q01_d">
                <material>
                  <mattext texttype="text/plain">This course has no in-person meeting</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ga2e95d699d77bbba38e84dd3e6d4675_q01_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ga2e95d699d77bbba38e84dd3e6d4675_q02" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What is the Census Date for Fall 2026, after which dropping this course results in a "W" on your transcript?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q02_a">
                <material>
                  <mattext texttype="text/plain">August 28, 2026</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q02_b">
                <material>
                  <mattext texttype="text/plain">September 8, 2026</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q02_c">
                <material>
                  <mattext texttype="text/plain">October 15, 2026</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q02_d">
                <material>
                  <mattext texttype="text/plain">November 20, 2026</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ga2e95d699d77bbba38e84dd3e6d4675_q02_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ga2e95d699d77bbba38e84dd3e6d4675_q03" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;By what time and day are weekly Labs, Discussions, and Quizzes due unless otherwise noted?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q03_a">
                <material>
                  <mattext texttype="text/plain">Friday at 5:00 PM</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q03_b">
                <material>
                  <mattext texttype="text/plain">Monday at 11:59 PM</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q03_c">
                <material>
                  <mattext texttype="text/plain">Sunday at 11:59 PM</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q03_d">
                <material>
                  <mattext texttype="text/plain">There is no consistent weekly deadline</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ga2e95d699d77bbba38e84dd3e6d4675_q03_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ga2e95d699d77bbba38e84dd3e6d4675_q04" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;According to the Late Work Policy, what happens to work submitted after the 3-day (72-hour) grace period?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q04_a">
                <material>
                  <mattext texttype="text/plain">It is accepted with no penalty at any time during the semester</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q04_b">
                <material>
                  <mattext texttype="text/plain">It receives a grade of zero unless documented extenuating circumstances are presented</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q04_c">
                <material>
                  <mattext texttype="text/plain">It automatically receives half credit regardless of circumstances</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q04_d">
                <material>
                  <mattext texttype="text/plain">Late work is never accepted under any circumstances, including the grace period</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ga2e95d699d77bbba38e84dd3e6d4675_q04_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ga2e95d699d77bbba38e84dd3e6d4675_q05" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;What percentage of your final grade comes from Hands-on Lab Assignments (Modules 01–15)?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q05_a">
                <material>
                  <mattext texttype="text/plain">20%</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q05_b">
                <material>
                  <mattext texttype="text/plain">30%</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q05_c">
                <material>
                  <mattext texttype="text/plain">50%</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q05_d">
                <material>
                  <mattext texttype="text/plain">70%</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ga2e95d699d77bbba38e84dd3e6d4675_q05_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ga2e95d699d77bbba38e84dd3e6d4675_q06" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Which certification does this course prepare you for?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q06_a">
                <material>
                  <mattext texttype="text/plain">CompTIA Network+ (N10-008)</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q06_b">
                <material>
                  <mattext texttype="text/plain">CompTIA A+ (220-1101/1102)</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q06_c">
                <material>
                  <mattext texttype="text/plain">CompTIA Security+ (SY0-701)</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q06_d">
                <material>
                  <mattext texttype="text/plain">(ISC)2 CISSP</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ga2e95d699d77bbba38e84dd3e6d4675_q06_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ga2e95d699d77bbba38e84dd3e6d4675_q07" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Per the Academic Integrity &amp;amp; Generative AI Policy, which of the following is considered academic dishonesty in this course?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q07_a">
                <material>
                  <mattext texttype="text/plain">Using an AI tool to help understand an error message while debugging a lab</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q07_b">
                <material>
                  <mattext texttype="text/plain">Using an AI tool to brainstorm how to approach a discussion prompt</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q07_c">
                <material>
                  <mattext texttype="text/plain">Directly copy-pasting AI-generated output as your submission without understanding or attribution</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q07_d">
                <material>
                  <mattext texttype="text/plain">Asking an AI tool to explain a security concept you don't understand</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ga2e95d699d77bbba38e84dd3e6d4675_q07_c</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="ga2e95d699d77bbba38e84dd3e6d4675_q08" title="Question">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>cc_profile</fieldlabel>
              <fieldentry>cc.multiple_choice.v0p1</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Per the Technology Requirements &amp;amp; Netiquette guidance, what is required before using any security tool taught in this course against a system?&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q08_a">
                <material>
                  <mattext texttype="text/plain">Nothing — the tools are safe to use against any system</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q08_b">
                <material>
                  <mattext texttype="text/plain">You must own the system or have explicit written authorization to test it</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q08_c">
                <material>
                  <mattext texttype="text/plain">You only need permission if the system is outside the United States</mattext>
                </material>
              </response_label>
              <response_label ident="ga2e95d699d77bbba38e84dd3e6d4675_q08_d">
                <material>
                  <mattext texttype="text/plain">Written authorization is only required for network scanning tools, not other tools</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">ga2e95d699d77bbba38e84dd3e6d4675_q08_b</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
    </section>
  </assessment>
</questestinterop>
